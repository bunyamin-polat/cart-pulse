# Copy to .env (`make setup`) and replace the placeholders. Never commit .env.
# Each database stores its password when its volume is first created.

MYSQL_ROOT_PASSWORD=change_me
MYSQL_PASSWORD=change_me
MYSQL_PORT=3306

MONGO_ROOT_PASSWORD=change_me
MONGO_PORT=27017

# 5434 avoids clashing with a PostgreSQL server already running on the host.
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5434

AIRFLOW_PORT=8088

# Optional pipeline settings, shown with their defaults.
# CARTPULSE_EXCLUDED_IPS=198.46.149.143
# Keep this longer than the longest write transaction in MySQL.
# CARTPULSE_WATERMARK_LOOKBACK_SECONDS=300
