# Copy to .env (`make setup`) and replace the placeholders. Never commit .env.

# MySQL (OLTP)
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3306

# MongoDB (product catalog)
MONGO_ROOT_PASSWORD=change_me
MONGO_PORT=27017

# PostgreSQL (data warehouse)
# 5434 avoids clashing with PostgreSQL servers already running on the host.
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5434

# Admin tools (optional, started with `make admin`)
PHPMYADMIN_PORT=8080
PGADMIN_PORT=5050
